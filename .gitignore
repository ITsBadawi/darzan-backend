# ═══════════════════════════════════════════════════════════════
# درازن — .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────
node_modules/
client/node_modules/

# ─── Production Build Outputs ─────────────────────────────────
dist/
client/dist/
build/
client/build/

# ─── Environment Variables (SENSITIVE!) ───────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
client/.env
client/.env.local
client/.env.*.local

# ─── Logs & Scratch ─────────────────────────────────────────────
*.log
*.err.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
scratch/
pnpm-debug.log*
lerna-debug.log*

# ─── OS Files ─────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── IDE / Editor ─────────────────────────────────────────────
.vscode/
.idea/
.cursor/
.agents/
.gemini/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ─── Archives & Temp ─────────────────────────────────────────
*.zip
*.tar.gz
*.rar
*.7z
tmp/
temp/
.tmp/

# ─── Coverage & Testing ──────────────────────────────────────
coverage/
.nyc_output/
*.lcov

# ─── Local Data (dev-only, not for production) ───────────────
# local_data.json is tracked for fallback seed data
# If you don't want it, uncomment:
# src/db/local_data.json
