# ═══════════════════════════════════════════════════════════════
# درازن — إعدادات البيئة (Darzan Environment Variables)
# انسخ هذا الملف إلى .env واملأ القيم الخاصة بمشروعك
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ─── Supabase Configuration ───────────────────────────────────
# تجدها في Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Server Configuration ─────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── CORS Allowed Origins (comma-separated) ───────────────────
# أضف روابط الدومين الخاص بك هنا
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://yourdomain.com

# ─── Telegram Bot Notification ─────────────────────────────────
# بوت تليجرام لإشعارات الطلبات الجديدة
# أنشئ بوت من @BotFather وأضفه كـ Admin في القناة
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_CHAT_ID=-1001234567890


